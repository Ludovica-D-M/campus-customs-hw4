# Campus Customs — environment template.
# Copy this file to `.env` at the project root and fill in your own values.
# `.env` itself is gitignored and must never be committed.

# Portkey gateway key, used to reach the OpenAI model (gpt-5.6-luna).
# Get your own from the course's Portkey workspace.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional. Set to 1 only when the site is served over HTTPS, so the session
# cookie is marked Secure. Leave unset for local http://localhost development.
# CAMPUS_CUSTOMS_HTTPS=0

# Optional. Key used to sign session cookies. If unset, the backend generates
# one on first run and keeps it in backend/.session_secret (also gitignored).
# CAMPUS_CUSTOMS_SECRET=
